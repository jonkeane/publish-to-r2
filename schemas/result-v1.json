{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r2publisher.local/schemas/result-v1.json",
  "title": "R2 Publisher result protocol v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "status": {
      "enum": [
        "failed",
        "committed"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "manifestUrl": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "status": {
            "enum": [
              "pending",
              "uploaded",
              "committed"
            ]
          },
          "key": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "errorCode": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errorCode": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "jobId",
    "status",
    "photos"
  ]
}
